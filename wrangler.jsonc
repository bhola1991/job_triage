{
  // Static-asset deploy for the app: index.html, config.js, manifest.json etc.
  // at the repo root, fronted by the Worker script in src/index.js (added for
  // POST /api/contact; everything else falls through to env.ASSETS.fetch()).
  // The app itself is still the single-file, no-backend thing the README
  // describes -- src/index.js is deploy plumbing, not part of the app.
  //
  // This file did not exist before 2026-09-17. Every earlier successful build
  // relied on `wrangler deploy`'s interactive wizard auto-generating an
  // equivalent config INSIDE the throwaway build container and discarding it
  // when the build finished -- so the deploy was never actually backed by a
  // committed config. The build's own deploy command later changed to
  // `wrangler versions upload`, which has no such auto-detect fallback and
  // fails immediately without a real file to read. This is that file.
  // Email Routing: the catch-all rule on jobtriage.app points at this Worker,
  // which is configured in the Cloudflare dashboard rather than here -- there
  // is no wrangler key for a routing rule. The email() export in src/index.js
  // is the handler. It needs two secrets that are NOT in this file and must
  // never be: run `wrangler secret put SUPABASE_URL` and
  // `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`.
  //
  // Before enabling Email Routing, check jobtriage.app for existing MX
  // records. Enabling it repoints the whole domain's mail at Cloudflare, and
  // the catch-all means this Worker then sees every address on it -- which is
  // why handleEmail forwards anything that is not a reply token instead of
  // storing it.
  "name": "jobtriage",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
