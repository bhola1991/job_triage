  "_workable_note": "Not crawled: apply.workable.com caps per DAY (429, Retry-After ~86000). Workable is covered by the jobs.workable.com aggregate the edge function queries per search. Slugs kept for the record.",
  "_jsonld_note": "Boards read by jsonld-boards.js: a job sitemap plus schema.org JobPosting data on each page. Found by probe-boards.js (verdict BULK). exclude is a regex over the url and the employment type.",
  "jsonld": {
    "placementindia.com": {
      "sitemap": "https://www.placementindia.com/sitemap/modified_job_details.xml"
    },
    "charityjob.co.uk": {
      "sitemap": "https://www.charityjob.co.uk/jobsitemap.xml",
      "exclude": "volunteer"
    },
    "agfunder.com": {
      "sitemap": "https://agfunder.com/job_listing-sitemap.xml"
    },
    "devnetjobsindia.org": {
      "sitemap": "https://devnetjobsindia.org/sitemap.aspx",
      "ids": {
        "title": "JD1_lblJobTitle",
        "company": "JD1_lblCompanyName",
        "location": [
          "JD1_lblLocation",
          "JD1_lblCountry"
        ],
        "description": "JD1_lblJobDesc",
        "valid_through": "JD1_lblPostedDate"
      },
      "_note": "lblPostedDate is the APPLY-BY date (the page labels it 'Apply by'); there is no posting date.",
      "match": "jobdescription\\.aspx\\?job_id="
    },
    "devnetjobs.org": {
      "sitemap": "https://devnetjobs.org/sitemap.aspx",
      "ids": {
        "title": "JD1_lblJobTitle",
        "company": "JD1_lblCompanyName",
        "location": [
          "JD1_lblLocation",
          "JD1_lblCountry"
        ],
        "description": "JD1_lblJobDesc",
        "valid_through": "JD1_lblPostedDate"
      },
      "match": "jobdescription\\.aspx\\?job_id="
    },
    "indgovtjobs.in": {
      "sitemap": "https://www.indgovtjobs.in/sitemap.xml?page=1",
      "_note": "Indian government job aggregator; JobPosting data per page."
    }
  }
